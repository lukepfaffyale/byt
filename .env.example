# Copy to .env (in this folder, or one folder above it) and fill in. Never commit the real file.

# Course key through Portkey. The only key needed to run the app locally.
PORTKEY_API_KEY=your-key-here

# Model. The course key allows gpt-6-luna only.
OPENAI_MODEL=gpt-6-luna

# Optional. Leave unset to use the small local SQLite database that ships with the repo.
# Set to a Postgres URL (Supabase) to use the hosted database instead.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# Optional. Comma-separated front-end addresses the back end accepts. Default: http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=http://localhost:5173
